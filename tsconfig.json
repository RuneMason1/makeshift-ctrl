{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "allowJs": true,
    "checkJs": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": "./",
    "strict": true,
    "paths": {
      "@eos-makeshift/msg": ["node_modules/@eos-makeshift/msg/lib/types/index.d.ts"],
      "@eos-makeshift/serial": ["node_modules/@eos-makeshift/serial/lib/types/index.d.ts"]
    },
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./types/renderer",
  },
  "include": [
    "./src"
  ],
  "references": [
    { "path": "./node-src/tsconfig.json" }
  ]
}
