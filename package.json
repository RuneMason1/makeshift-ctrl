{
  "name": "makeshift-ctrl",
  "productName": "makeshift-ctrl",
  "version": "0.4.2",
  "description": "Desktop interface for MakeShift",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "npm run set-build -- development electron-forge start",
    "gen-api": "tsc --emitDeclarationOnly -p ./node-src && vue-tsc --emitDeclarationOnly",
    "docgen": "typedoc",
    "package": "npm run set-build -- development electron-forge package",
    "make": "npm run set-build -- development electron-forge make",
    "publish": "npm run set-build -- production electron-forge publish",
    "postinstall": "node ./scripts/postinstall.mjs",
    "set-build": "node ./scripts/set-build.mjs",
    "typecheck": "npm run gen-api",
    "test:core": "node --test node-src/control/runtime/tests/*.test.mjs",
    "check:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ../.codex/verify-release-manifest.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EosFoundry/makeshift-ctrl.git"
  },
  "author": {
    "name": "James Liu",
    "email": "james@eosfoundry.dev"
  },
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/EosFoundry/makeshift-ctrl/issues"
  },
  "homepage": "https://github.com/EosFoundry/makeshift-ctrl#readme",
  "config": {},
  "dependencies": {
    "@blockly/field-grid-dropdown": "^13.2.0",
    "@blockly/theme-dark": "^13.2.0",
    "@blockly/theme-modern": "^13.2.0",
    "@eos-makeshift/msg": "^1.3.2",
    "@eos-makeshift/serial": "file:../makeshift-serial/eos-makeshift-serial-6.3.0.tgz",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "autoprefixer": "^10.5.4",
    "blockly": "^13.2.1",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "colorjs.io": "^0.7.1",
    "defu": "^6.1.7",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "fs-extra": "^11.4.0",
    "highlight.js": "^11.11.1",
    "jsdom": "29.1.1",
    "nanoid": "^6.0.1",
    "octokit": "^5.0.5",
    "pathe": "^2.0.3",
    "postcss": "^8.5.26",
    "proper-lockfile": "^4.1.2",
    "purify-ts": "^2.1.4",
    "sass": "^1.102.0",
    "semver": "^7.8.5",
    "stylelint": "^17.14.1",
    "tailwindcss": "^3.4.17",
    "update-electron-app": "^3.3.0",
    "uuid": "^14.0.1",
    "winston": "^3.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-ligatures": "^0.7.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-flatpak": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-snap": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/asar": "^4.2.1",
    "@material-symbols/svg-400": "^0.47.1",
    "@reforged/maker-appimage": "^5.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "ace-builds": "^1.44.0",
    "electron": "^43.3.0",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vite-electron-plugin": "^0.8.3",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-html-config": "^2.0.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "@eos-makeshift/serial": {
      "nanoid": "^5.1.16"
    },
    "@eos-makeshift/msg": {
      "serialize-javascript": "^7.0.5"
    }
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_HOSTNAME": "127.0.0.1",
      "VITE_DEV_SERVER_PORT": 3344,
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344"
    }
  }
}
